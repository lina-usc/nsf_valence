   "begin": "324.640",
   "children": [],
   "end": "327.520",
   "id": "f000122",
   "language": "eng",
   "lines": [
    "smoking a cigarette."
   ]
  },
  {
   "begin": "327.520",
   "children": [],
   "end": "328.960",
   "id": "f000123",
   "language": "eng",
   "lines": [
    "I understood right there"
   ]
  },
  {
   "begin": "328.960",
   "children": [],
   "end": "330.400",
   "id": "f000124",
   "language": "eng",
   "lines": [
    "my haircut was something"
   ]
  },
  {
   "begin": "330.400",
   "children": [],
   "end": "332.360",
   "id": "f000125",
   "language": "eng",
   "lines": [
    "that had been out of the power of the barber"
   ]
  },
  {
   "begin": "332.360",
   "children": [],
   "end": "333.880",
   "id": "f000126",
   "language": "eng",
   "lines": [
    "and then I slowly walked outside"
   ]
  },
  {
   "begin": "333.880",
   "children": [],
   "end": "334.680",
   "id": "f000127",
   "language": "eng",
   "lines": [
    "to join the man."
   ]
  },
  {
   "begin": "334.680",
   "children": [],
   "end": "342.320",
   "id": "f000128",
   "language": "eng",
   "lines": [
    "He looked down, smiled at me, then he patted me on the top of my bald as a coot head."
