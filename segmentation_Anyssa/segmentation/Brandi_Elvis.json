  },
  {
   "begin": "317.080",
   "children": [],
   "end": "319.560",
   "id": "f000119",
   "language": "eng",
   "lines": [
    "To show his anger,"
   ]
  },
  {
   "begin": "319.560",
   "children": [],
   "end": "323.240",
   "id": "f000120",
   "language": "eng",
   "lines": [
    "the man hit the wall with his hand and then walked outside"
   ]
  },
  {
   "begin": "323.240",
   "children": [],
   "end": "324.640",
   "id": "f000121",
   "language": "eng",
   "lines": [
    "where he stood against the brick wall,"
   ]
  },
