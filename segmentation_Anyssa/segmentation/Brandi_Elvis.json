  },
  {
   "begin": "300.480",
   "children": [],
   "end": "304.400",
   "id": "f000113",
   "language": "eng",
   "lines": [
    "The matron was smiling at me sort of funny like."
   ]
  },
  {
   "begin": "304.400",
   "children": [],
   "end": "306.560",
   "id": "f000114",
   "language": "eng",
   "lines": [
    "The barber"
   ]
  },
  {
   "begin": "306.560",
   "children": [],
   "end": "307.520",
   "id": "f000115",
   "language": "eng",
   "lines": [
    "upset by the matron"
   ]
  },
