   "begin": "307.520",
   "children": [],
   "end": "310.920",
   "id": "f000116",
   "language": "eng",
   "lines": [
    "said to her, 'You are just a damn bitch, lady.'"
   ]
  },
  {
   "begin": "310.920",
   "children": [],
   "end": "314.600",
   "id": "f000117",
   "language": "eng",
   "lines": [
    "She yelled back at him at the top of her lungs,"
   ]
  },
  {
   "begin": "314.600",
   "children": [],
   "end": "317.080",
   "id": "f000118",
   "language": "eng",
   "lines": [
