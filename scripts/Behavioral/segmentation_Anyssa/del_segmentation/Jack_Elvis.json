   "begin": "305.480",
   "children": [],
   "end": "308.520",
   "id": "f000116",
   "language": "eng",
   "lines": [
    "said to her, 'You are just a damn bitch, lady.'"
   ]
  },
  {
   "begin": "308.520",
   "children": [],
   "end": "312.560",
   "id": "f000117",
   "language": "eng",
   "lines": [
    "She yelled back at him at the top of her lungs,"
   ]
  },
  {
   "begin": "312.560",
   "children": [],
   "end": "315.920",
   "id": "f000118",
   "language": "eng",
   "lines": [
    "before walking toward the office, as fast as she could."
   ]
  },
  {
   "begin": "315.920",
   "children": [],
   "end": "318.280",
   "id": "f000119",
   "language": "eng",
   "lines": [
    "To show his anger,"
   ]
  },
  {
   "begin": "318.280",
   "children": [],
   "end": "321.720",
   "id": "f000120",
   "language": "eng",
   "lines": [
    "the man hit the wall with his hand and then walked outside"
   ]
  },
  {
   "begin": "321.720",
   "children": [],
   "end": "323.200",
   "id": "f000121",
   "language": "eng",
   "lines": [
    "where he stood against the brick wall,"
   ]
  },
  {
   "begin": "323.200",
   "children": [],
   "end": "326.160",
   "id": "f000122",
   "language": "eng",
   "lines": [
    "smoking a cigarette."
   ]
  },
  {
   "begin": "326.160",
   "children": [],
   "end": "327.840",
   "id": "f000123",
   "language": "eng",
   "lines": [
    "I understood right there"
   ]
  },
  {
   "begin": "327.840",
   "children": [],
   "end": "329.280",
   "id": "f000124",
   "language": "eng",
   "lines": [
    "my haircut was something"
   ]
  },
  {
   "begin": "329.280",
   "children": [],
   "end": "331.760",
   "id": "f000125",
   "language": "eng",
   "lines": [
    "that had been out of the power of the barber"
   ]
  },
  {
   "begin": "331.760",
   "children": [],
   "end": "333.080",
   "id": "f000126",
   "language": "eng",
   "lines": [
    "and then I slowly walked outside"
   ]
  },
  {
   "begin": "333.080",
   "children": [],
   "end": "333.880",
   "id": "f000127",
   "language": "eng",
   "lines": [
    "to join the man."
   ]
  },
  {
   "begin": "333.880",
   "children": [],
   "end": "341.560",
   "id": "f000128",
   "language": "eng",
   "lines": [
    "He looked down, smiled at me, then he patted me on the top of my bald as a coot head."
   ]
  },
  {
   "begin": "341.560",
   "children": [],
   "end": "344.720",
   "id": "f000129",
   "language": "eng",
   "lines": [
    "It was a fact of my life"
   ]
