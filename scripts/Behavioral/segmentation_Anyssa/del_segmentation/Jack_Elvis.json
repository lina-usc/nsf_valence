   "begin": "264.520",
   "children": [],
   "end": "266.880",
   "id": "f000103",
   "language": "eng",
   "lines": [
    "I handed him the nickel back and told him"
   ]
  },
  {
   "begin": "266.880",
   "children": [],
   "end": "267.920",
   "id": "f000104",
   "language": "eng",
   "lines": [
    "that I was not hungry."
   ]
  },
  {
   "begin": "267.920",
   "children": [],
   "end": "271.920",
   "id": "f000105",
   "language": "eng",
   "lines": [
    "'I'm so sorry, baby,' he said,"
