  {
   "begin": "283.880",
   "children": [],
   "end": "286.920",
   "id": "f000110",
   "language": "eng",
   "lines": [
    "that had accumulated on my shiny new Buster Brown shoes."
   ]
  },
  {
   "begin": "286.920",
   "children": [],
   "end": "290.200",
   "id": "f000111",
   "language": "eng",
   "lines": [
    "My head was no longer in the clouds,"
   ]
  },
  {
   "begin": "290.200",
   "children": [],
   "end": "297.280",
   "id": "f000112",
   "language": "eng",
   "lines": [
    "and I got up off the floor, brushed off my short pants, and walked sullenly towards the door."
   ]
  },
  {
   "begin": "297.280",
   "children": [],
   "end": "301.840",
   "id": "f000113",
   "language": "eng",
   "lines": [
    "The matron was smiling at me sort of funny like."
   ]
  },
  {
   "begin": "301.840",
   "children": [],
   "end": "304.040",
   "id": "f000114",
   "language": "eng",
   "lines": [
    "The barber"
   ]
  },
  {
   "begin": "304.040",
   "children": [],
   "end": "305.480",
   "id": "f000115",
   "language": "eng",
   "lines": [
    "upset by the matron"
   ]
  },
